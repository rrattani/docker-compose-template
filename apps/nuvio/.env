# ===========================================================================
# Host Identity & Directory Permissions
# ===========================================================================
PUID=${PUID}
PGID=${PGID}
TZ=${TZ}

# ===========================================================================
# Domain & Traefik Routing Configuration
# ===========================================================================
NUVIO_HOSTNAME=${NUVIO_HOSTNAME}

# Canonical Public Endpoints (Single-domain architecture via Traefik & Kong)
SITE_URL=https://${NUVIO_HOSTNAME}
API_EXTERNAL_URL=https://${NUVIO_HOSTNAME}
PUBLIC_URL=https://${NUVIO_HOSTNAME}
SUPABASE_PUBLIC_URL=https://${NUVIO_HOSTNAME}

# ===========================================================================
# Core Database Settings (Resolves to nuvio_db via internal alias "db")
# ===========================================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your_generated_postgres_password

PGPORT=${POSTGRES_PORT}
PGDATABASE=${POSTGRES_DB}
PGPASSWORD=${POSTGRES_PASSWORD}

PGSODIUM_KEY=your_generated_postgres_password

# ===========================================================================
# Cryptographic Keys & Tokens (Generated via Node.js script)
# ===========================================================================
JWT_SECRET=${NUVIO_JWT_SECRET:-}
JWT_EXPIRY=3600

# Generated JWTs (Signed using JWT_SECRET above with role claims)
ANON_KEY=${NUVIO_ANON_KEY:-}
SERVICE_ROLE_KEY=${NUVIO_SERVICE_ROLE_KEY:-}

SECRET_KEY_BASE=your_generated_secret_key_base_64_hex_chars
VAULT_ENC_KEY=your_generated_vault_enc_key_64_hex_chars
PG_META_CRYPTO_KEY=your_generated_pg_meta_crypto_key_64_hex_chars
POOLER_TENANT_ID=your_generated_pooler_tenant_id

# Dashboard Web UI Credentials
DASHBOARD_USERNAME=nuvio
DASHBOARD_PASSWORD=your_generated_dashboard_password

# Optional asymmetric and opaque API keys. Legacy JWT keys remain supported.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# ===========================================================================
# PostgREST Configuration (Data & Catalog API)
# ===========================================================================
PGRST_DB_URI=postgres://authenticator:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
PGRST_DB_ANON_ROLE=anon
PGRST_DB_USE_LEGACY_GUCS=false

PGRST_ADMIN_SERVER_PORT=3001
PGRST_ADMIN_SERVER_HOST=localhost

PGRST_JWT_SECRET=${JWT_SECRET}

PGRST_APP_SETTINGS_JWT_SECRET=${JWT_SECRET}
PGRST_APP_SETTINGS_JWT_EXP=${JWT_EXPIRY}

# ===========================================================================
# Supabase Auth (GoTrue) Configuration
# ===========================================================================
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999

GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
GOTRUE_DB_DRIVER=postgres

GOTRUE_SITE_URL=${SITE_URL}
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_DISABLE_SIGNUP=${DISABLE_SIGNUP:-false}

GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_SECRET=${JWT_SECRET}
GOTRUE_JWT_EXP=${JWT_EXPIRY}
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_KEYS=${JWT_KEYS:-[]}
GOTRUE_JWT_ISSUER=${API_EXTERNAL_URL}/auth/v1

GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true

# ===========================================================================
# Supabase Storage & Imgproxy Configuration
# ===========================================================================
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage
SERVICE_KEY=${SERVICE_ROLE_KEY}
STORAGE_FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=nuvio
TENANT_ID=nuvio
REGION=local
STORAGE_PUBLIC_URL=${SUPABASE_PUBLIC_URL}
DATABASE_URL=postgres://supabase_storage_admin:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ENABLE_IMAGE_TRANSFORMATION=true
IMGPROXY_URL=http://imgproxy:5001
AUTH_JWT_SECRET=${JWT_SECRET}

IMGPROXY_BIND=:5001
IMGPROXY_LOCAL_FILESYSTEM_ROOT=/
IMGPROXY_USE_ETAG=true
IMGPROXY_AUTO_WEBP=true
IMGPROXY_MAX_SRC_RESOLUTION=16.8

S3_PROTOCOL_ACCESS_KEY_ID=your_generated_s3_key_id
S3_PROTOCOL_ACCESS_KEY_SECRET=your_generated_s3_key_secret

# ===========================================================================
# Realtime Engine Configuration
# ===========================================================================
PORT=4000
DB_HOST=${POSTGRES_HOST}
DB_PORT=${POSTGRES_PORT}
DB_USER=supabase_admin
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}
DB_AFTER_CONNECT_QUERY="SET search_path TO _realtime"
DB_ENC_KEY=supabaserealtime
API_JWT_SECRET=${JWT_SECRET}
SECRET_KEY_BASE=${SECRET_KEY_BASE}
METRICS_JWT_SECRET=${JWT_SECRET}
ERL_AFLAGS="-proto_dist inet_tcp"
DNS_NODES=""
RLIMIT_NOFILE=10000
APP_NAME=realtime-dev
SEED_SELF_HOST=true
RUN_JANITOR=true
DISABLE_HEALTHCHECK_LOGGING=true

# ===========================================================================
# Studio & Metadata Configuration
# ===========================================================================
PG_META_PORT=8080
PG_META_DB_HOST=${POSTGRES_HOST}
PG_META_DB_PORT=${POSTGRES_PORT}
PG_META_DB_NAME=${POSTGRES_DB}
PG_META_DB_USER=supabase_admin
PG_META_DB_PASSWORD=${POSTGRES_PASSWORD}
CRYPTO_KEY=${PG_META_CRYPTO_KEY}

STUDIO_PG_META_URL=http://meta:8080
STUDIO_DEFAULT_ORGANIZATION=Nuvio
STUDIO_DEFAULT_PROJECT=Default

DEFAULT_ORGANIZATION_NAME=${STUDIO_DEFAULT_ORGANIZATION}
DEFAULT_PROJECT_NAME=${STUDIO_DEFAULT_PROJECT}
OPENAI_API_KEY=${OPENAI_API_KEY}

SUPABASE_URL=http://kong:8000
SUPABASE_REST_URL=http://kong:8000/rest/v1/
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_KEY=${SERVICE_ROLE_KEY}
SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
SUPABASE_SECRET_KEY=${SUPABASE_SECRET_KEY}
      
ENABLED_FEATURES_LOGS_ALL=false

# ===========================================================================
# Dashboard Frontend Configuration
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://${NUVIO_HOSTNAME}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}

FUNCTIONS_VERIFY_JWT=false
# ===========================================================================
# Upstream Nuvio Cloud Integrations (Optional)
# ===========================================================================
# Uncomment if you want to seed with Nuvio's upstream cloud catalog:
# NUVIO_CLOUD_URL=https://api.nuvio.tv
# NUVIO_CLOUD_PUBLISHABLE_KEY=sb_publishable_1Clq8rlTVACkdcZuqr6_AD__xUUC_EN
# DEFAULT_CATALOG_URL=https://catalog.nuvio.tv/manifest.json
